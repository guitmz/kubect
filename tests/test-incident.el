       "api-123" "app" "ctx" "ns"
       '(:since "15m"))
      (should (member "--since=15m" captured))
      (should (member "-c" captured)))))

(ert-deftest kubect-restart-window-log-output-uses-since-time-and_previous_logs ()
  (let (calls)
    (cl-letf (((symbol-function 'kubect--kubectl-json)
               (lambda (&rest args)
                 (should (equal args
                                '("--context" "ctx" "--namespace" "ns" "get" "pod" "api-123" "-o" "json")))
                 '((status . ((containerStatuses . (((name . "app")
                                                    (lastState . ((terminated . ((finishedAt . "2026-05-21T10:00:00Z")))))
                                                    (state . ((running . ((startedAt . "2026-05-21T10:02:00Z")))))))))))))
              ((symbol-function 'kubect--kubectl-output)
               (lambda (&rest args)
                 (push args calls)
                 (if (member "--previous=true" args)
                     "previous logs"
                   "current logs"))))
      (let ((output (kubect--bulk-log-snapshot-output
                     "api-123" "app" "ctx" "ns" '(:restart-window t))))
        (should (string-match-p "Window starts at 2026-05-21T09:55:00Z" output))
        (should (string-match-p "== Previous container ==" output))
        (should (string-match-p "previous logs" output))
        (should (string-match-p "== Current container ==" output))
        (should (string-match-p "current logs" output))
        (should (= (length calls) 2))
        (should (cl-some (lambda (args)
                           (member "--previous=true" args))
                         calls))
        (should (cl-every (lambda (args)
                            (member "--since-time=2026-05-21T09:55:00Z" args))
                          calls))))))

(ert-deftest kubect-effective-log-snapshot-options-prefers_rollout_timestamp ()
  (cl-letf (((symbol-function 'kubect--resource-rollout-since-time)
             (lambda (&rest _args)
               "2026-05-21T10:10:00Z")))
    (should
     (equal (plist-get
             (kubect--effective-log-snapshot-options
              '(:kind "deployment" :name "api" :context "ctx" :namespace "ns")
              '(:restart-window t))
             :since-time)
            "2026-05-21T10:10:00Z"))))

(ert-deftest kubect-restart-window-log-output-falls-back-without_restart_data ()
  (let ((pod-json '((status . ((containerStatuses . (((name . "app")
                                                      (state . ())))))))))
    (cl-letf (((symbol-function 'kubect--kubectl-json)
               (lambda (&rest _args)
                 pod-json))
              ((symbol-function 'kubect--kubectl-output)
               (lambda (&rest args)
                 (should-not (cl-some (lambda (item)
                                        (and (stringp item)
                                             (string-prefix-p "--since-time=" item)))
                                      args))
                 "current logs")))
      (let ((output (kubect--bulk-log-snapshot-output
                     "api-123" "app" "ctx" "ns" '(:restart-window t))))
        (should (string-match-p "No restart timestamp found" output))
        (should (string-match-p "current logs" output))))))

(ert-deftest kubect-resource-at-point-parses-yaml-document ()
  (with-temp-buffer
    (insert "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: api-server\n  namespace: staging\nspec:\n  replicas: 2\n")
    (goto-char (point-min))
    (let ((kubect--project-state (make-hash-table :test #'equal)))
      (cl-letf (((symbol-function 'kubect--project-key) (lambda () "project-a"))
                ((symbol-function 'kubect--kubectl-output)
                 (lambda (&rest args)
                   (pcase args
                     (`("config" "current-context") "ctx-a")
                     (`("config" "view" "--minify" "-o" "jsonpath={..namespace}") "default")
                     (_ (error "Unexpected args: %S" args))))))
        (should
         (equal (kubect--resource-at-point)
                '(:kind "deployments"
                  :name "api-server"
                  :namespace "staging"
                  :context "ctx-a")))))))

(ert-deftest kubect-yaml-field-path-at-point-builds-dotted-field-path ()
  (with-temp-buffer
    (insert "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: api\nspec:\n  template:\n    spec:\n      containers:\n        - name: api\n          image: repo/app:1\n")
    (goto-char (point-min))
    (search-forward "image:")
    (should (equal (kubect--yaml-field-path-at-point)
                   "spec.template.spec.containers.image"))))

(ert-deftest kubect-explain-resource-at-point-prefers-field-path-in-yaml ()
  (with-temp-buffer
    (insert "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: api\nspec:\n  template:\n    spec:\n      containers:\n        - name: api\n          image: repo/app:1\n")
    (goto-char (point-min))
    (search-forward "image:")
    (let (captured)
      (cl-letf (((symbol-function 'compilation-start)
                 (lambda (command &rest _args)
                   (setq captured command)))
                ((symbol-function 'kubect-current-context)
                 (lambda () "ctx"))
                ((symbol-function 'kubect-current-namespace)
                 (lambda () "ns"))
                ((symbol-function 'kubect--kubectl-output)
                 (lambda (&rest _)
                   (error "This test must not invoke kubectl")))
                ((symbol-function 'kubect--shell-command)
                 (lambda (args) args))
                ((symbol-function 'kubect--kubectl-base-args)
                 (lambda (&optional _context _namespace)
                   '("--context" "ctx" "--namespace" "ns"))))
        (kubect-explain-resource-at-point)
        (should (equal captured
                       '("--context" "ctx" "--namespace" "ns"
                         "explain" "deployment.spec.template.spec.containers.image")))))))

