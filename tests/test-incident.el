(require 'test-support)

(ert-deftest kubect-event-object-at-point-finds-kind-name-token ()
  (with-temp-buffer
    (insert "2m Warning BackOff Pod/api-123 Back-off restarting failed container\n")
    (goto-char (point-min))
    (should (equal (kubect--event-object-at-point) "Pod/api-123"))))

(ert-deftest kubect-event-output-keeps-visible-event-object-order-when-filtered ()
  (let ((session (kubect-session-create
                  :name "ctx/ns/events"
                  :context "ctx"
                  :namespace "ns"
                  :resource "events"
                  :filter "api")))
    (cl-letf (((symbol-function 'kubect--kubectl-output)
               (lambda (&rest args)
                 (should (equal args
                                '("--context" "ctx"
                                  "--namespace" "ns"
                                  "get" "events"
                                  "--sort-by=.lastTimestamp")))
                 (string-join
                  '("LAST SEEN   TYPE      REASON    OBJECT         MESSAGE"
                    "1m          Warning   BackOff   Pod/api-1      restarting"
                    "2m          Normal    Pulled    Pod/worker-1   pulled image"
                    "3m          Warning   Failed    Pod/api-2      failed probe")
                  "\n")))
              ((symbol-function 'kubect--event-objects-for-session)
               (lambda (_session)
                 '("Pod/api-1" "Pod/worker-1" "Pod/api-2"))))
      (should
       (equal (kubect--table-output session)
              (string-join
               '("LAST SEEN   TYPE      REASON    OBJECT         MESSAGE"
                 "1m          Warning   BackOff   Pod/api-1      restarting"
                 "3m          Warning   Failed    Pod/api-2      failed probe")
               "\n")))
      (should (equal (kubect-session-event-objects session)
                     '("Pod/api-1" "Pod/api-2"))))))

