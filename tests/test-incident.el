(ert-deftest kubect-rollout-diff-resource-uses_latest_two_replicasets ()
  (let (shown)
    (cl-letf (((symbol-function 'kubect--resource-plist-from-session)
               (lambda ()
                 '(:kind "deployment" :name "api" :context "ctx" :namespace "ns")))
              ((symbol-function 'kubect--deployment-replicasets)
               (lambda (_deployment _context _namespace)
                 (list (list :name "api-rs1" :revision 1)
                       (list :name "api-rs2" :revision 2)
                       (list :name "api-rs3" :revision 3))))
              ((symbol-function 'kubect--kubectl-json)
               (lambda (&rest args)
                 (let ((json-object-type 'alist)
                       (json-array-type 'list)
                       (json-key-type 'symbol))
                 (pcase args
                    (`("--context" "ctx" "--namespace" "ns" "get" "replicaset" "api-rs2" "-o" "json")
                     (json-read-from-string
                      "{\"spec\":{\"template\":{\"spec\":{\"containers\":[{\"name\":\"api\",\"image\":\"old\"}]}}}}"))
                    (`("--context" "ctx" "--namespace" "ns" "get" "replicaset" "api-rs3" "-o" "json")
                     (json-read-from-string
                      "{\"spec\":{\"template\":{\"spec\":{\"containers\":[{\"name\":\"api\",\"image\":\"new\"}]}}}}"))
                   (_ (error "Unexpected args: %S" args))))))
              ((symbol-function 'kubect--rollout-diff-buffer)
               (lambda (old-name new-name old-body new-body context namespace &optional _arg)
                 (setq shown (list old-name new-name old-body new-body context namespace)))))
      (kubect-rollout-diff-resource)
      (should (equal (nth 0 shown) "api-rs2 (r2) pod template"))
      (should (equal (nth 1 shown) "api-rs3 (r3) pod template"))
      (should (string-match-p "\"image\": \"old\"" (nth 2 shown)))
      (should (string-match-p "\"image\": \"new\"" (nth 3 shown)))
      (should (equal (nthcdr 4 shown) '("ctx" "ns"))))))

