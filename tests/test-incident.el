(ert-deftest kubect-incident-rollout-history-resource-opens_rollout_report ()
  (with-temp-buffer
    (kubect-session-mode)
    (let ((inhibit-read-only t)
          displayed)
      (insert "NAME READY STATUS RESTARTS AGE\n")
      (insert "api 1/1 Running 0 2m\n")
      (goto-char (point-min))
      (forward-line 1)
      (cl-letf (((symbol-function 'kubect--current-line-resource-plist)
                 (lambda ()
                   '(:kind "deployment" :name "api" :context "ctx" :namespace "ns")))
                ((symbol-function 'kubect--pod-for-resource)
                 (lambda (&rest _args) "api-123"))
                ((symbol-function 'kubect--select-container-for-pod)
                 (lambda (&rest _args) "app"))
                ((symbol-function 'kubect--effective-log-snapshot-options)
                 (lambda (resource options)
                   (should (equal (plist-get resource :kind) "deployment"))
                   (should (equal options '(:restart-window t)))
                   '(:restart-window t :since-time "2025-01-01T00:00:00Z")))
                ((symbol-function 'kubect--restart-window-log-data)
                 (lambda (_pod _container _context _namespace options)
                   (should (equal options '(:restart-window t :since-time "2025-01-01T00:00:00Z")))
                   '(:since-time "2025-01-01T00:00:00Z"
                     :anchor "rollout window")))
                ((symbol-function 'kubect--event-summary-lines-for-resource)
                 (lambda (_resource)
                   '("Warning rollout Something changed")))
                ((symbol-function 'kubect--kubectl-output)
                 (lambda (&rest args)
                   (should (equal args
                                  '("--context" "ctx" "--namespace" "ns"
                                    "rollout" "history" "deployment/api")))
                   "REVISION  CHANGE-CAUSE\n1  restarted"))
                ((symbol-function 'kubect--bulk-log-snapshot-output)
                 (lambda (pod container context namespace options)
                   (should (equal (list pod container context namespace)
                                  '("api-123" "app" "ctx" "ns")))
                   (should (equal options '(:restart-window t :since-time "2025-01-01T00:00:00Z")))
                   "logs here"))
                ((symbol-function 'kubect--show-report-buffer)
                 (lambda (_title body _context _namespace _arg header &optional _state)
                   (setq displayed (list header body)))))
        (kubect-incident-rollout-history-resource)
        (should (equal (car displayed)
                       "Rollout triage: ctx/ns window=2025-01-01T00:00:00Z (rollout window)"))
        (should (string-match-p "== Rollout history ==" (cadr displayed)))
        (should (string-match-p "REVISION  CHANGE-CAUSE" (cadr displayed)))
        (should (string-match-p "== Rollout window logs ==" (cadr displayed)))
        (should (string-match-p "Pod api-123, container app" (cadr displayed)))))))

