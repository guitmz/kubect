(ert-deftest kubect-incident-logs-resource-prefers-previous-for-restarty-rows ()
  (with-temp-buffer
    (kubect-session-mode)
    (let ((inhibit-read-only t)
          chosen)
      (insert "NAME READY STATUS RESTARTS AGE\n")
      (insert "api-123 0/1 CrashLoopBackOff 7 1m\n")
      (goto-char (point-min))
      (forward-line 1)
      (cl-letf (((symbol-function 'kubect--current-line-resource-plist)
                 (lambda ()
                   '(:kind "deployment" :name "api" :context "ctx" :namespace "ns")))
                ((symbol-function 'kubect--pod-for-resource)
                 (lambda (&rest _args) "api-123"))
                ((symbol-function 'kubect--select-container-for-pod)
                 (lambda (&rest _args) "app"))
                ((symbol-function 'kubect-logs-previous)
                 (lambda (&rest _args)
                   (setq chosen 'previous)))
                ((symbol-function 'kubect-logs)
                 (lambda (&rest _args)
                   (setq chosen 'current))))
        (kubect-incident-logs-resource)
        (should (eq chosen 'previous))))))

