(ert-deftest kubect-timeline-for-resource-uses-field-selector ()
  (let (captured-args displayed)
    (cl-letf (((symbol-function 'kubect--resource-for-command)
               (lambda ()
                 '(:kind "deployment" :name "api" :context "ctx" :namespace "default")))
              ((symbol-function 'kubect--record-session-command)
               (lambda (&rest _) nil))
              ((symbol-function 'kubect--kubectl-json)
               (lambda (&rest args)
                 (setq captured-args args)
                 '((items . ()))))
              ((symbol-function 'kubect--display-buffer)
               (lambda (buffer)
                 (setq displayed buffer))))
      (kubect-timeline-for-resource))
    (should (member "--field-selector" captured-args))
    (should (member "involvedObject.kind=Deployment,involvedObject.name=api" captured-args))
    (with-current-buffer displayed
      (should (eq major-mode 'kubect-report-mode))
      (should (string-match-p "timeline deployment/api" (buffer-string))))))

